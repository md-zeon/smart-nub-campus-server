model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?
  coverImage   String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  websiteUrl   String?

  location        String?
  phoneNumber     String?
  currentSemester Int?
  batchYear       Int?

  // Career profile (Alumni role feature)
  currentEmployer       String?
  jobTitle              String?
  industry              String?
  showInAlumniDirectory Boolean  @default(true)
  isMentor              Boolean  @default(false)
  mentorshipTopics      String[] @default([])

  // Mentor profile (Mentorship feature)
  mentorHeadline      String?
  mentorBio           String?
  mentorAvailability  String?
  mentorCadence       MentorshipCadence?
  mentorMeetingFormat MeetingPreference?
  mentorMaxMentees    Int @default(3)

  searchTsv Unsupported("tsvector")?

  @@index([searchTsv], type: Gin)
  @@index([mentorHeadline(ops: raw("gin_trgm_ops"))], type: Gin)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}
