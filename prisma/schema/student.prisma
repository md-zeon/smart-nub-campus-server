model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId         String            @unique
  department        Department
  admissionYear     Int
  admissionSemester AdmissionSemester
  dateOfBirth       DateTime

  // Academic status (Alumni role feature)
  academicStatus        AcademicStatus      @default(ENROLLED)
  graduationYear        Int?
  graduationSemester    AdmissionSemester?
  graduationDate        DateTime?
  degreeTitle           String?
  cgpa                  Decimal?            @db.Decimal(4, 2)
  graduatedById         String?
  graduatedBy           User?               @relation("GraduationReviewer", fields: [graduatedById], references: [id], onDelete: SetNull)
  graduatedAt           DateTime?
  transitionConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([admissionYear])
  @@index([admissionSemester])
  @@index([academicStatus])
  @@index([graduationYear])
  @@map("student")
}
